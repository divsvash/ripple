# Ripple backend configuration. Copy to backend/.env (or set in your host's
# environment settings). Placeholders only: never commit real values.
#
# There is deliberately NO SerpApi key setting. Every user connects their own
# SerpApi key in the browser; it lives only in their server-side session.

# --- AI provider (Gemini) -----------------------------------------------------
# Option A (recommended): operator-provided key, used for all users' LLM calls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried automatically when GEMINI_MODEL is overloaded or rate limited (empty disables).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Option B: if GEMINI_API_KEY is empty and this is true, users are asked for
# their own Gemini key (stored the same way as their SerpApi key).
ALLOW_USER_GEMINI_KEY=true

# --- Sessions -------------------------------------------------------------------
# Fernet key used to encrypt session payloads. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Optional for a single in-memory instance (an ephemeral key is generated),
# REQUIRED when REDIS_URL is set.
SESSION_ENCRYPTION_KEY=
# Shared session store for multiple workers/instances, e.g. redis://localhost:6379/0
REDIS_URL=
SESSION_TTL_SECONDS=3600
SESSION_MAX_AGE_SECONDS=43200

# --- HTTP -----------------------------------------------------------------------
# Must be true in production (HTTPS). Set false only for local http://localhost.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Only needed if the frontend is served from a different origin than the API
# (comma-separated). Leave empty for the default same-origin setups.
CORS_ORIGINS=
# Directory of the built static frontend to serve (set automatically in Docker).
FRONTEND_DIST=

# --- Limits ---------------------------------------------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=10
DISCOVERY_RATE_LIMIT_PER_MINUTE=6
# Each search uses one credit of the user's SerpApi quota.
MAX_INITIAL_QUERIES=5
MAX_FOLLOWUP_QUERIES=3
RESULTS_PER_QUERY=6
